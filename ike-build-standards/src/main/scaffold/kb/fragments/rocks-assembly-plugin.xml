            <!-- The Rocks store as a zip Komet's "Download from Maven" unpacks under ~/Solor, rkb
                 for "Open Rocks KB". Bound to verify: in package it would run before kb-assemble
                 builds the store, since ike-parent declares this plugin first. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>rocks-store-zip</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/rkb.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
