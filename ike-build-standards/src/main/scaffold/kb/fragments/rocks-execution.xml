                    <execution>
                        <id>rocks-store</id>
                        <goals>
                            <goal>kb-assemble</goal>
                        </goals>
                        <configuration>
                            <!-- The reasoned export loaded into a RocksDB store, for Komet's
                                 "Open Rocks KB" download (classifier rkb). Nothing is
                                 classified or exported again. -->
                            <storeRoot>${project.build.directory}/kb-rocks</storeRoot>
                            <inputs>
                                <input>PB ${project.build.directory}/${project.artifactId}-${project.version}-reasoned-pb.zip</input>
                            </inputs>
                            <classify>false</classify>
                            <reasonedPb>false</reasonedPb>
                            <attachReasonedPb>false</attachReasonedPb>
                            <forkJvmArguments>
                                <forkJvmArgument>${kb.heap}</forkJvmArgument>
                                <forkJvmArgument>-Dike.knowledge.storeController=Open Rocks KB</forkJvmArgument>
                            </forkJvmArguments>
                        </configuration>
                    </execution>
