
    <profiles>
        <!-- Authoring in Komet: harvests the change sets captured in the installed store into
             changesets/ (before anything is folded), then installs the classified store the
             assembly builds for Komet at ${kb.install}. -->
        <profile>
            <id>komet</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>network.ike.tooling</groupId>
                        <artifactId>ike-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>harvest-sessions</id>
                                <goals>
                                    <goal>changeset-harvest</goal>
                                </goals>
                                <configuration>
                                    <installDirectory>${kb.install}</installDirectory>
                                    <changeSetDirectory>${kb.changesets}</changeSetDirectory>@changeSetModules@
                                </configuration>
                            </execution>
                            <execution>
                                <id>assemble-knowledge-base</id>
                                <configuration>
                                    <installDirectory>${kb.install}</installDirectory>
                                    <!-- Harvested above; here only the guard that refuses to
                                         replace a store holding change sets not yet harvested. -->
                                    <changeSetDirectory>${kb.changesets}</changeSetDirectory>@changeSetModules@
                                    <replayChangeSets>false</replayChangeSets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
