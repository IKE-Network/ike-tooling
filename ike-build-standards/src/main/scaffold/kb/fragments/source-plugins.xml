            <plugin>
                <groupId>network.ike.tooling</groupId>
                <artifactId>ike-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>export-source</id>
                        <goals>
                            <goal>kb-assemble</goal>
                        </goals>
                        <configuration>
                            <!-- The base first, so every identity the release resolves to is
                                 present; then the release. Only what the import writes is
                                 exported, unclassified: classification belongs to an assembly. -->
                            <inputs>
@inputs@                            </inputs>
                            <classify>false</classify>
                            <sourceDeltaFile>${project.build.directory}/${project.artifactId}-${project.version}-unreasoned-pb.zip</sourceDeltaFile>
                            <forkJvmArguments>
                                <forkJvmArgument>${kb.heap}</forkJvmArgument>
                            </forkJvmArguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verify-on-base</id>
                        <goals>
                            <goal>knowledge-verify</goal>
                        </goals>
                        <configuration>
                            <!-- The artifact must load on its base and resolve every reference
                                 within the two. -->
                            <artifact>${project.build.directory}/${project.artifactId}-${project.version}-unreasoned-pb.zip</artifact>
                            <baseInputs>
@baseInputs@                            </baseInputs>
                            <checks>
                                <check>PRESENCE</check>
                                <check>FIT_REFERENCES</check>
                            </checks>
                            <forkJvmArguments>
                                <forkJvmArgument>${kb.heap}</forkJvmArgument>
                            </forkJvmArguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
