<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd"@rootAttribute@>
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>network.ike.platform</groupId>
        <artifactId>ike-parent</artifactId>
        <version>@parentVersion@</version>
        <relativePath/>
    </parent>
    <groupId>@groupId@</groupId>
    <artifactId>@artifactId@</artifactId>
    <version>@version@</version>
    <packaging>pom</packaging>
    <name>@displayName@</name>
    <description>
        @description@
    </description>

    <!-- The repository's own folder until a remote is added: ike-version-management-extension
         requires the POM beside .git to declare its scm, and "Add remote" replaces both URLs. -->
    <scm>
        <url>@scmUrl@</url>
        <connection>scm:git:@scmUrl@</connection>
        <developerConnection>scm:git:@scmUrl@</developerConnection>
    </scm>

    <!-- Where a deploy goes. A knowledge base built from licensed releases deploys only to
         restricted repositories, never to ike-parent's defaults, which the anonymous
         ike-public group serves. The site entry is required: ike-parent's enforcer fails a
         project whose effective site URL still points at the in-reactor location. -->
    <distributionManagement>
        <repository>
            <id>@distributionId@</id>
            <url>@releasesUrl@</url>
        </repository>
        <snapshotRepository>
            <id>@distributionId@</id>
            <url>@snapshotsUrl@</url>
        </snapshotRepository>
        <site>
            <id>ike-site</id>
            <url>@siteUrl@</url>
        </site>
    </distributionManagement>

    <properties>
        <!-- Never Maven Central: ike-parent publishes there by default, and a knowledge base
             may carry licensed releases. -->
        <ike.publishToCentral>false</ike.publishToCentral>
@properties@
    </properties>

    <dependencies>
@dependencies@
    </dependencies>

    <build>
        <plugins>
@plugins@
        </plugins>
    </build>
@profiles@</project>
