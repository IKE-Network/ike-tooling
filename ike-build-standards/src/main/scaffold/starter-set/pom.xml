<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.platform</groupId>
        <artifactId>ike-parent</artifactId>
        <version>@parentVersion@</version>
        <relativePath/>
    </parent>

    <groupId>@groupId@</groupId>
    <artifactId>@artifactRoot@</artifactId>
    <version>@version@</version>
    <packaging>pom</packaging>

    <name>@setName@ @familyLabel@</name>
    <description>
        @tag@ @familyLabelLower@: the ledger-form content set for @setName@.
        The source is an append-only version ledger (declared stamps, birth-FQN
        identity); building replays the ledger; the released artifact is a change set.
        Generated by ike:starter-set-create; the SOP is the dev-knowledge-set-sop
        topic family in ike-lab-documents.
    </description>
    <url>https://ike.network/@artifactRoot@/</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>IKE Network</name>
        <url>https://ike.network</url>
    </organization>

    <!-- Required: ike-parent's enforcer fails an inheriting project whose effective
         site URL still points at the in-reactor location (ike-issues#380/#383). -->
    <distributionManagement>
        <site>
            <id>ike-site</id>
            <url>https://ike.network/@artifactRoot@/</url>
        </site>
    </distributionManagement>

    <properties>
        <!-- INTERIM: the chronology-store authoring tier (ike-issues#822); resolves
             from a local .m2 until the feature branch merges and releases. -->
        <chronology-store.version>@chronologyStoreVersion@</chronology-store.version>
        <ike-knowledge-provider.version>@providerVersion@</ike-knowledge-provider.version>
    </properties>

    <subprojects>
        <subproject>@slug@-terms</subproject>
        <subproject>@slug@-bindings</subproject>
        <subproject>@slug@-changeset</subproject>
        <subproject>@slug@-doc</subproject>
        <subproject>@slug@-kb</subproject>
    </subprojects>
</project>
