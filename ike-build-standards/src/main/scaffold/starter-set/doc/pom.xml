<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>@groupId@</groupId>
        <artifactId>@artifactRoot@</artifactId>
    </parent>

    <artifactId>@slug@-doc</artifactId>
    <packaging>pom</packaging>

    <name>@setName@ @familyLabel@ — Guide</name>
    <description>
        Documentation for the @tag@ @familyLabelLower@. The comprehensive Koncept
        glossary renders from the koncepts.yml the change-set module extracts from
        the loaded store.
    </description>

    <properties>
        <pdf.source.document>@slug@-guide</pdf.source.document>
        <koncept-asciidoc-extension.version>@konceptExtensionVersion@</koncept-asciidoc-extension.version>
        <koncepts.yml>${project.basedir}/../@slug@-changeset/target/@slug@-koncepts.yml</koncepts.yml>
    </properties>

    <dependencies>
        <!-- Build-order only: the change-set module extracts the koncepts.yml this
             guide renders. -->
        <dependency>
            <groupId>@groupId@</groupId>
            <artifactId>@slug@-changeset</artifactId>
            <version>240</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.asciidoctor</groupId>
                <artifactId>asciidoctor-maven-plugin</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>network.ike.docs</groupId>
                        <artifactId>koncept-asciidoc-extension</artifactId>
                        <version>${koncept-asciidoc-extension.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <attributes>
                        <koncept-definitions-file>${koncepts.yml}</koncept-definitions-file>
                        <koncept-glossary-all/>
                    </attributes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
