<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>@groupId@</groupId>
        <artifactId>@artifactRoot@</artifactId>
    </parent>

    <artifactId>@slug@-bindings</artifactId>
    <packaging>jar</packaging>

    <name>@setName@ Bindings</name>
    <description>
        Generated bindings for the @tag@ knowledge set: resolved UUID literals with
        definitions as javadoc, autocompletable in any IDE. Depends only on the
        terms surface, so consumers stay light.
    </description>

    <dependencies>
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>terms</artifactId>
            <version>${chronology-store.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>common</artifactId>
            <version>${chronology-store.version}</version>
        </dependency>
        <!-- The ledger this module generates from — optional, never propagated. -->
        <dependency>
            <groupId>@groupId@</groupId>
            <artifactId>@slug@-terms</artifactId>
            <version>242</version>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>network.ike.tooling</groupId>
                <artifactId>ike-maven-plugin</artifactId>
                <version>@toolingVersion@</version>
                <executions>
                    <execution>
                        <id>generate-knowledge-bindings</id>
                        <goals>
                            <goal>knowledge-bindings</goal>
                        </goals>
                        <configuration>
                            <packageName>@basePackage@.bindings</packageName>
                            <className>@className@Terms</className>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
