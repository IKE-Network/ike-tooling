<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>@groupId@</groupId>
        <artifactId>@artifactRoot@</artifactId>
    </parent>

    <artifactId>@slug@-kb</artifactId>
    <packaging>pom</packaging>

    <name>@setName@ Knowledge Base</name>
    <description>
        The full-cycle knowledge base: the base plus this set's change set,
        assembled and classified by ike:kb-assemble and installed into the
        data-source directory for verification in Komet. Verification edits are
        captured under the installed store's changeSets directory and feed the
        next iteration as CHANGESET file inputs below.
    </description>

    <dependencies>
        <dependency>
            <groupId>network.ike.knowledge</groupId>
            <artifactId>ike-knowledge-provider</artifactId>
            <version>${ike-knowledge-provider.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Build-order only: the change set below must exist before assembly. -->
        <dependency>
            <groupId>@groupId@</groupId>
            <artifactId>@slug@-changeset</artifactId>
            <version>236</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>network.ike.tooling</groupId>
                <artifactId>ike-maven-plugin</artifactId>
                <version>@toolingVersion@</version>
                <executions>
                    <execution>
                        <id>assemble-knowledge-base</id>
                        <goals>
                            <goal>kb-assemble</goal>
                        </goals>
                        <configuration>
                            <inputs>
                                <input>@baseArtifactSpec@</input>
                                <input>CHANGESET ${project.basedir}/../@slug@-changeset/target/@slug@-changeset-236-changeset.zip</input>
                                <!-- Next iteration: change sets captured during Komet
                                     verification load on top, e.g.
                                <input>CHANGESET ${user.home}/Solor/@slug@-kb/changeSets/User_yyyyMMdd_HHmmss_ike-cs.zip</input>
                                -->
                            </inputs>
                            <installDirectory>${user.home}/Solor/@slug@-kb</installDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
