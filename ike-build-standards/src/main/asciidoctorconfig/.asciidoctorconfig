// The shared .asciidoctorconfig of every IKE repository: the asciidoctorconfig
// classifier of ike-build-standards. ike-parent unpacks it once, at the reactor
// root, so {asciidoctorconfigdir} is the repository and the IDE preview of every
// module resolves includes in the one AsciiDoc union the build writes there
// (design topic dev-adoc-packages; IKE-Network/ike-issues#1343).
:adoc: {asciidoctorconfigdir}/target/generated-sources/adoc
// {topics} is the migration alias of {adoc}; it goes when the last consumer has
// moved to {adoc} (IKE-Network/ike-issues#1346).
:topics: {asciidoctorconfigdir}/target/generated-sources/adoc
// {generated} stays until nothing uses it.
:generated: {asciidoctorconfigdir}/target/generated-sources/asciidoc
